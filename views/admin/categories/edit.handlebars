<h1>Edit Category</h1>

{{#each errors}}
    <div class="alert alert-danger">{{message}}</div>
{{/each}}

<form action="/admin/categories/edit/{{category.id}}?_method=PUT" method="post">
    <div class="form-group">
        <label for="title">Name</label>
        <input name="name" type="text" class="form-control" id="name" placeholder="Enter name" value="{{category.name}}" />
    </div>

    <button type="submit" class="btn btn-primary">Update Category</button>
</form>